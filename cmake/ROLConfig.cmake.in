@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/ROLTargets.cmake")

set(ROL_FOUND TRUE)
set(ROL_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(ROL_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(ROL_LIBRARIES ROL::rol)

# Compatibility alias for consumers that look for an uppercase ROL target.
if(TARGET ROL::rol AND NOT TARGET ROL::ROL)
  add_library(ROL::ROL INTERFACE IMPORTED)
  target_link_libraries(ROL::ROL INTERFACE ROL::rol)
endif()

check_required_components(ROL)
